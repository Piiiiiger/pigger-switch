{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pigger Switch",
  "version": "1.0.0",
  "identifier": "com.pigger.switch",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm run dev:renderer",
    "beforeBuildCommand": "pnpm run build:renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pigger Switch",
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 14,
          "y": 16
        },
        "width": 1100,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; script-src 'self' 'sha256-Gxa9LDVfc2CUOuNh657Tu4lUaMhDJ1mYxRIQ9oUJvlI='; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://models.dev"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "template": "wix/per-user-main.wxs"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
